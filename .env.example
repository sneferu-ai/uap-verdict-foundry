# UAP Verdict Foundry environment template. Copy to `.env` and edit.
# REQUIRED: operator authentication token (web login + CLI possession check + API bearer).
# Your login, API bearer and CLI check. Left blank on purpose: nothing can sign in
# until you set it. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UAPV_OPERATOR_TOKEN=

# Mock mode (SNEFERU_MOCK=1) is the default for first-launch / development /
# CI because it needs no live engine credentials and produces deterministic
# fixtures (FR-018). Set to 0 for live-engine production only after the
# operator has configured the engine endpoint and authentication (FR-005).
# The spec's mode model is exactly two modes: SNEFERU_MOCK=1 or the live
# Sneferu engine. There is no simulation runtime — the removed third mode
# silently spent live-engine money under a "simulation" label, so selecting
# it now fails closed.
SNEFERU_MOCK=1

# DORMANT Phase 2 controlling-source tooling (round 5: the strict-by-default
# intake gate was unspec'd and has been REMOVED — these knobs gate nothing).
# They drive the informational `uapvf references status/fetch` operator tools
# only. UAPV_REFERENCE_SOURCE_BASE deliberately has no default; set both only
# if you operate the dormant phase-2 reference tooling.
# UAPV_REFERENCE_MODE=strict
# UAPV_REFERENCE_SOURCE_BASE=

# Buyer-facing delivery (signing passphrase, HMAC key) is phase 2 — not
# part of the MVP (spec.md:84/92). The operator exports and delivers
# reports manually.

# Optional loopback-only CLI bypass (audited). Leave unset in normal use.
# UAPV_ALLOW_LOCAL_ADMIN=0

# External data sources. Archive and ADS-B are optional; the orbital
# catalog is refreshed manually (`uapvf tle refresh`, A-012). Per S8 all
# three are REPORTED by /readyz but never required for `ready: true`.
# Missing per-case coverage still returns `insufficient`, never an
# invented negative.
# ARCHIVE_MIRROR_PATH=/absolute/path/to/astronomical_catalog.sqlite
# ADSB_SOURCE_URL=https://www.adsbexchange.com/api/aircraft/v2
# ADSB_SOURCE_API_KEY=YOUR_ADSB_EXCHANGE_KEY
# Evaluation-only alternative; anonymous OpenSky is live-current only:
# ADSB_SOURCE_URL=https://opensky-network.org/api/states/all
# OPENSKY_CLIENT_ID=YOUR_OPENSKY_CLIENT_ID
# OPENSKY_CLIENT_SECRET=YOUR_OPENSKY_CLIENT_SECRET
# Modern CelesTrak OMM JSON includes six-digit catalog numbers; legacy TLE does not.
# TLE_CATALOG_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=ACTIVE&FORMAT=JSON
# UAPV_EGRESS_ALLOWLIST=www.adsbexchange.com,opensky-network.org,auth.opensky-network.org,celestrak.org

# Installed by `uapvf model install-resnet50 --file ...`; all four are
# returned by that command. The public key is a trust pin, not a secret.
# UAPV_RESNET50_ONNX=/absolute/path/resnet50-v1-12-int8.onnx
# UAPV_RESNET50_MAPPING=/absolute/path/imagenet-taxonomy-mapping.json
# UAPV_RESNET50_RECEIPT=/absolute/path/model-receipt.json
# UAPV_RESNET50_TRUSTED_PUBLIC_KEY=BASE64URL_ED25519_PUBLIC_KEY

# Optional cost schedule overrides (USD). Defaults depend on mode:
# mock: 0.01 lineage / 0.01 fiction; live: 0.05 lineage / 0.05 fiction.
# FR-023 estimate = lineage_cost x 3 + fiction_cost.
# UAPV_COST_LINEAGE_USD=0.05
# UAPV_COST_FICTION_USD=0.05

# Monthly compute spend cap in USD.
# UAPV_SPEND_CAP_USD=200

# Dashboard retention reminder (S2 warning badge). Case data is retained
# until the operator manually deletes it — there is no auto-deletion job
# in the MVP (spec §5 retention; deferred to phase 2).
# RETENTION_DAYS=365
